<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/bg">
  <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:maxWidth="560dp" android:layout_gravity="center"
        android:orientation="vertical" android:background="@drawable/card_bg" android:padding="32dp">

      <TextView android:layout_width="64dp" android:layout_height="64dp"
          android:background="@drawable/logo_bg" android:gravity="center" android:text="STV"
          android:textColor="@color/accent_dark" android:textSize="20sp" android:textStyle="bold"/>

      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:layout_marginTop="20dp" android:text="STV Instalador"
          android:textColor="@color/text" android:textSize="30sp" android:textStyle="bold"/>

      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:layout_marginTop="8dp" android:text="Digite seu código de ativação para continuar"
          android:textColor="@color/muted" android:textSize="17sp"/>

      <EditText android:id="@+id/codeInput"
          android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="24dp"
          android:background="@drawable/field_bg" android:paddingHorizontal="20dp"
          android:hint="CÓDIGO DE ATIVAÇÃO" android:textColorHint="@color/muted"
          android:textColor="@color/text" android:textSize="20sp" android:letterSpacing="0.1"
          android:inputType="textCapCharacters|textNoSuggestions" android:maxLength="64"
          android:imeOptions="actionDone" android:singleLine="true"
          android:nextFocusDown="@+id/validateBtn"/>

      <Button android:id="@+id/validateBtn"
          android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="20dp"
          android:background="@drawable/btn_primary" android:text="VALIDAR CÓDIGO"
          android:textColor="@color/accent_dark" android:textSize="18sp" android:textStyle="bold"
          android:focusable="true" android:nextFocusUp="@id/codeInput" android:nextFocusDown="@+id/downloadBtn"/>

      <ProgressBar android:id="@+id/spinner"
          android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center"
          android:layout_marginTop="16dp" android:indeterminateTint="@color/accent" android:visibility="gone"/>

      <TextView android:id="@+id/status"
          android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
          android:textSize="17sp" android:textColor="@color/muted" android:visibility="gone"/>

      <Button android:id="@+id/downloadBtn"
          android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="16dp"
          android:background="@drawable/btn_primary" android:text="BAIXAR APLICATIVO"
          android:textColor="@color/accent_dark" android:textSize="18sp" android:textStyle="bold"
          android:visibility="gone" android:nextFocusUp="@id/validateBtn" android:nextFocusDown="@+id/otherBtn"/>

      <ProgressBar android:id="@+id/progress" style="@android:style/Widget.ProgressBar.Horizontal"
          android:layout_width="match_parent" android:layout_height="12dp" android:layout_marginTop="16dp"
          android:max="100" android:progressDrawable="@drawable/progress" android:visibility="gone"/>

      <TextView android:id="@+id/progressText"
          android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
          android:textColor="@color/muted" android:textSize="15sp" android:visibility="gone"/>

      <Button android:id="@+id/installBtn"
          android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="16dp"
          android:background="@drawable/btn_primary" android:text="INSTALAR"
          android:textColor="@color/accent_dark" android:textSize="18sp" android:textStyle="bold"
          android:visibility="gone"/>

      <Button android:id="@+id/otherBtn"
          android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp"
          android:background="@drawable/btn_secondary" android:text="Usar outro código"
          android:textColor="@color/text" android:textSize="17sp" android:textAllCaps="false"
          android:visibility="gone"/>

      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
          android:text="Após o download, confirme a instalação na tela do Android. Códigos inválidos, expirados ou bloqueados não liberam o download."
          android:textColor="@color/muted" android:textSize="14sp"/>
    </LinearLayout>
  </FrameLayout>
</ScrollView>
