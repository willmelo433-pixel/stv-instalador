<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_focused="true">
    <shape><solid android:color="@color/secondary"/><corners android:radius="14dp"/><stroke android:width="3dp" android:color="@color/focus"/></shape>
  </item>
  <item android:state_pressed="true">
    <shape><solid android:color="#44484E"/><corners android:radius="14dp"/></shape>
  </item>
  <item>
    <shape><solid android:color="@color/secondary"/><corners android:radius="14dp"/></shape>
  </item>
</selector>
